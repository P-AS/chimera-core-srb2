From 1638e0552682c068a1505390b65dbc4b253d70a1 Mon Sep 17 00:00:00 2001
From: PAS <pasrc@proton.me>
Date: Sun, 4 Oct 2026 18:32:00 -0400
Subject: [PATCH] feat(cores): SRB2's controller has mnemonics of its own

chimera-core-srb2 (an unofficial game core, github.com/P-AS/chimera-core-srb2)
declares system SRB2 with SRB2's keyboard as buttons. Its names already
give distinct fallback letters (Turn left l, Strafe Left L...); this
table gives them Doom's directions instead (^ v < > { }), and the axes
Fwd, Side, Turn, Aim.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01KmA5vUr2aPFUfecLj4PFJi
---
 .../Base Implementations/MnemonicLookup.cs    | 33 +++++++++++++++++++
 .../gui/Chimera.Emulation.Common/VSystemID.cs |  1 +
 2 files changed, 34 insertions(+)

diff --git a/source/gui/Chimera.Emulation.Common/Base Implementations/MnemonicLookup.cs b/source/gui/Chimera.Emulation.Common/Base Implementations/MnemonicLookup.cs
index c9fba5d..3bd7b72 100644
--- a/source/gui/Chimera.Emulation.Common/Base Implementations/MnemonicLookup.cs	
+++ b/source/gui/Chimera.Emulation.Common/Base Implementations/MnemonicLookup.cs	
@@ -1298,6 +1298,32 @@ namespace Chimera.Emulation.Common
 				["START"] = 'S',
 				["RESET"] = 'r',
 			},
+			[VSystemID.Raw.SRB2] = new()
+			{
+				// the directions as Doom has them: arrows for moving, braces for turning
+				["Forward"] = '^',
+				["Backward"] = 'v',
+				["Strafe Left"] = '<',
+				["Strafe Right"] = '>',
+				["Turn left"] = '{',
+				["Turn right"] = '}',
+				["Look Up"] = 'U',
+				["Look Down"] = 'D',
+				["Jump"] = 'J',
+				["Spin"] = 'S',
+				["Center View"] = 'C',
+				["Reset Camera"] = 'R',
+				["Camera Toggle"] = 'T',
+				["Custom 1"] = '1',
+				["Custom 2"] = '2',
+				["Custom 3"] = '3',
+				["Pause"] = 'P',
+				// the menus' keys (Select is the Enter key), and a prompt's yes and no
+				["Select"] = 'E',
+				["Escape"] = 'X',
+				["Yes"] = 'Y',
+				["No"] = 'N',
+			},
 			[VSystemID.Raw.Doom] = new()
 			{
 				["Automap Toggle"] = 'a',
@@ -1537,6 +1563,13 @@ namespace Chimera.Emulation.Common
 				["Mouse Scroll X"] = "msX",
 				["Mouse Scroll Y"] = "msY",
 			},
+			[VSystemID.Raw.SRB2] = new()
+			{
+				["Forward Move"] = "Fwd",
+				["Side Move"] = "Side",
+				["Turn"] = "Turn",
+				["Aim"] = "Aim",
+			},
 			[VSystemID.Raw.Doom] = new()
 			{
 				["Camera Mode"] = "cM",
diff --git a/source/gui/Chimera.Emulation.Common/VSystemID.cs b/source/gui/Chimera.Emulation.Common/VSystemID.cs
index 57f3639..9dd58fb 100644
--- a/source/gui/Chimera.Emulation.Common/VSystemID.cs
+++ b/source/gui/Chimera.Emulation.Common/VSystemID.cs
@@ -65,6 +65,7 @@ namespace Chimera.Emulation.Common
 			public const string SGXCD = "SGXCD";
 			public const string SMS = "SMS";
 			public const string SNES = "SNES";
+			public const string SRB2 = "SRB2";
 			public const string TI83 = "TI83";
 			public const string TIC80 = "TIC80";
 			public const string UZE = "UZE";
-- 
