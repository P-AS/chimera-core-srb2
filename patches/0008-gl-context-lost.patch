+// -----------------+
+// ContextLost      : The context is gone: every GL name held here names
+//                  : nothing (or, in a context that lives on, something
+//                  : else). Forget them all without deleting any: deleting
+//                  : a stale name could delete an object made since.
+// -----------------+
+EXPORT void HWRAPI(ContextLost) (void)
+{
+	INT32 i;
+
+	while (TexCacheHead)
+	{
+		FTextureInfo *pTexInfo = TexCacheHead;
+		if (pTexInfo->texture)
+			pTexInfo->texture->downloaded = 0;
+		TexCacheHead = pTexInfo->next;
+		free(pTexInfo);
+	}
+	TexCacheTail = TexCacheHead = NULL;
+	tex_downloaded = 0;
+	NOTEXTURE_NUM = 0;
+
+	while (LightTablesHead)
+	{
+		LTListItem *item = LightTablesHead;
+		LightTablesHead = item->next;
+		free(item);
+	}
+	LightTablesTail = NULL;
+	lt_downloaded = 0;
+
+	for (i = 0; i < NUMSCREENTEXTURES; i++)
+		screenTextures[i] = 0;
+	screenPaletteTex = 0;
+	memset(screenPalette, 0, sizeof(screenPalette)); // SetScreenPalette uploads the next one
+	paletteLookupTex = 0;
+
+#ifdef GL_SHADERS
+	for (i = 0; i < HWR_MAXSHADERS; i++)
+		gl_shaders[i].program = 0;
+	gl_fallback_shader.program = 0;
+	memset(&gl_shaderstate, 0, sizeof(gl_shaderstate));
+#endif
+}
+
+// -----------------+
+// ContextRestored  : The renderer's own objects and states, in the new
+//                  : context; the hardware renderer makes the rest again
+//                  : (HWR_ContextRestored).
+// -----------------+
+EXPORT void HWRAPI(ContextRestored) (void)
+{
+	SetModelView(screen_width, screen_height);
+	SetStates();
+#ifdef GL_SHADERS
+	if (pglUseProgram && gl_fallback_shader.vertex_shader)
+		Shader_CompileProgram(&gl_fallback_shader, -1);
+#endif
+}
+
 #endif //HWRENDER
