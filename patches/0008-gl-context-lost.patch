+// --------------------------------------------------------------------------
+// The GL context was lost and another is current (a platform layer whose
+// context can be replaced under the renderer): forget every GL name the
+// hardware renderer holds, without deleting any, then make its objects again
+// in the new context. Textures and light tables are made again as they are
+// used; shaders, palettes and model buffers here.
+// --------------------------------------------------------------------------
+static void HWR_ForgetModelVBOs(model_t *model)
+{
+	INT32 i, j;
+	for (i = 0; i < model->numMeshes; i++)
+	{
+		mesh_t *mesh = &model->meshes[i];
+		for (j = 0; j < mesh->numFrames; j++)
+		{
+			if (mesh->frames)
+				mesh->frames[j].vboID = 0;
+			else if (mesh->tinyframes)
+				mesh->tinyframes[j].vboID = 0;
+		}
+	}
+}
+
+extern RGBA_t mapPalette[256]; // hw_cache.c
+
+void HWR_ContextLost(void)
+{
+	extracolormap_t *exc;
+	size_t i;
+
+	HWD.pfnContextLost();
+	for (exc = extra_colormaps; exc; exc = exc->next)
+		exc->gl_lighttable.id = 0;
+	gl_sky.vbo = 0;
+	gl_sky.rebuild = true;
+	for (i = 0; i < NUMSPRITES; i++)
+		if (md2_models[i].model)
+			HWR_ForgetModelVBOs(md2_models[i].model);
+	for (i = 0; i < md2_numplayermodels; i++)
+		if (md2_playermodels[i].model)
+			HWR_ForgetModelVBOs(md2_playermodels[i].model);
+}
+
+void HWR_ContextRestored(void)
+{
+	size_t i;
+
+	HWD.pfnContextRestored();
+	if (gl_shadersavailable)
+		HWR_CompileShaders();
+	memset(mapPalette, 0, sizeof(mapPalette));
+	HWR_SetPalette(pLocalPalette);
+	if (HWR_ShouldUsePaletteRendering())
+		HWR_SetMapPalette();
+	for (i = 0; i < NUMSPRITES; i++)
+		if (md2_models[i].model)
+			HWD.pfnCreateModelVBOs(md2_models[i].model);
+	for (i = 0; i < md2_numplayermodels; i++)
+		if (md2_playermodels[i].model)
+			HWD.pfnCreateModelVBOs(md2_playermodels[i].model);
+}
+
