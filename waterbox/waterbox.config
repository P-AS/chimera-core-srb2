{
  "coreName": "SRB2",
  "systemId": "SRB2",
  "kind": "game",
  "author": "Sonic Team Junior (Sonic Robo Blast 2, from Doom Legacy); unofficial Chimera port by P-AS",
  "url": "https://github.com/P-AS/chimera-core-srb2",
  "deterministic": true,
  "_memory_note": "[sbrk, sealed, invisible, plain, mmap] MiB: the engine's zone, its screens (five at the resolution, 41 MiB at 3840x2160) and the pk3s' cached lumps on the heap (and mmap past it), the engine's 16 MiB cothread stack in mmap; the picture's buffer (33 MiB at 3840x2160) and the sound's invisible (output, not the machine). As run-wbx has them.",
  "memoryLayoutMiB": [
    256,
    4,
    64,
    4,
    1024
  ],
  "video": {
    "_comment": "The software renderer at the resolution setting (up to 3840x2160), shown with square pixels as SRB2 is: the live size comes from GetVideoWidth/Height and the display aspect from GetDisplayAspectX/Y, which is that size itself.",
    "width": 3840,
    "height": 2160,
    "virtualWidth": 320,
    "virtualHeight": 200,
    "vsyncNumerator": 35,
    "vsyncDenominator": 1,
    "getBgra": "GetVideoBgra"
  },
  "audio": {
    "_comment": "The core's own mixer (platform/i_sound.c): a step is a tic, 1260 frames at 44100 Hz.",
    "rate": 44100,
    "samplesPerFrame": 1260,
    "channels": 2,
    "get": "GetAudio"
  },
  "lag": {
    "inputWasRead": "InputWasRead"
  },
  "input": {
    "name": "SRB2 Controller",
    "_comment": "SRB2's own keyboard in its default (FPS) scheme, pressed as keys - the menus read them too - and the menus' Select (Enter) and Escape, a prompt's Yes and No; and axes added into the tic command for exact values (Forward Move and Side Move count only while their keys are not held; Aim 0 leaves the game's own look). The ring-slinger controls (Fire, Fire Normal, Toss Flag, the weapons) are left out for now. The order is srb2-input.c's. The names give TAStudio distinct letters in any Chimera build (it falls back to a name's last word).",
    "buttons": [
      "Forward",
      "Backward",
      "Strafe Left",
      "Strafe Right",
      "Turn left",
      "Turn right",
      "Look Up",
      "Look Down",
      "Jump",
      "Spin",
      "Center View",
      "Reset Camera",
      "Camera Toggle",
      "Custom 1",
      "Custom 2",
      "Custom 3",
      "Pause",
      "Select",
      "Escape",
      "Yes",
      "No"
    ],
    "axes": [
      {
        "name": "Forward Move",
        "min": -50,
        "max": 50,
        "neutral": 0
      },
      {
        "name": "Side Move",
        "min": -50,
        "max": 50,
        "neutral": 0
      },
      {
        "name": "Turn",
        "min": -32768,
        "max": 32767,
        "neutral": 0
      },
      {
        "name": "Aim",
        "min": -32768,
        "max": 32767,
        "neutral": 0
      }
    ]
  },
  "settings": [
    {
      "name": "playStyle",
      "display": "Play Style",
      "type": "enum",
      "options": [
        "Strafe",
        "Manual",
        "Automatic",
        "Old Analog"
      ],
      "default": "Manual",
      "description": "The 1P play style (Setup > Play Style): Strafe (the player faces the camera), Manual (the player faces where it moves; the camera does not turn by itself), Automatic (SRB2's own default: the camera turns to follow), Old Analog (2.1's analog control)."
    },
    {
      "name": "cameraSpeed",
      "display": "Camera Speed",
      "type": "float",
      "default": 1.0,
      "description": "How fast the camera catches up with the player (cam_speed), 0 to 1; SRB2's own default is 0.3."
    },
    {
      "name": "scoreTimeRings",
      "display": "Score/Time/Rings",
      "type": "enum",
      "options": [
        "Classic",
        "Centiseconds",
        "Mania",
        "Tics"
      ],
      "default": "Mania",
      "description": "How the HUD shows the time (timerres): Classic (m:ss), Centiseconds (m:ss.cc), Mania (m:ss.cc, the score and ring counts lined up under it, as in Sonic Mania), Tics (the level's tic count)."
    },
    {
      "name": "flipCamera",
      "display": "Flip Camera with Gravity",
      "type": "bool",
      "default": true,
      "description": "The camera turns upside down with the player's gravity (flipcam)."
    },
    {
      "name": "autoBrake",
      "display": "Automatic Braking",
      "type": "bool",
      "default": true,
      "description": "The player brakes on their own when no direction is held, instead of skidding on (autobrake)."
    },
    {
      "name": "tutorialPrompt",
      "display": "Tutorial Prompt",
      "type": "bool",
      "default": false,
      "description": "Whether the title asks \"Do you want to play a brief Tutorial?\" on a first start (tutorialprompt). SRB2's own default is On."
    },
    {
      "name": "unlockModes",
      "display": "Unlock Record Attack, NiGHTS Mode and Marathon Run",
      "type": "bool",
      "default": false,
      "description": "Start with Record Attack and NiGHTS Mode unlocked (SRB2 offers Marathon Run whenever Record Attack is), so a run needs no movie that earns them."
    },
    {
      "name": "unlockCharacters",
      "display": "Unlock All Characters",
      "type": "bool",
      "default": false,
      "description": "Start with every character unlocked (Amy, Fang, Metal Sonic)."
    },
    {
      "name": "unlockAll",
      "display": "Unlock All Secrets",
      "type": "bool",
      "default": false,
      "description": "Start with every unlockable unlocked: the modes, the characters, Level Select, Sound Test, Pandora's Box, the emblem hints and radar, and the rest."
    },
    {
      "name": "resolution",
      "display": "Resolution",
      "type": "enum",
      "options": [
        "3840x2160",
        "2560x1440",
        "1920x1200",
        "1920x1080",
        "1680x1050",
        "1600x1200",
        "1600x1000",
        "1600x900",
        "1536x864",
        "1366x768",
        "1440x900",
        "1280x1024",
        "1280x960",
        "1280x800",
        "1280x720",
        "1152x864",
        "1024x768",
        "960x600",
        "800x600",
        "640x480",
        "640x400",
        "320x240",
        "320x200"
      ],
      "default": "1280x800",
      "description": "The picture's size, shown with square pixels: SRB2's own video modes, and 2560x1440 and 3840x2160 beyond them. SRB2's own default is 1280x800. Only the picture changes: the game plays identically at every resolution. Larger is slower to draw (turbo skips only the conversion)."
    },
    {
      "name": "warp",
      "display": "Start Map",
      "type": "string",
      "default": "",
      "description": "A map to start in, as the game's -warp takes it (a number, or MAPxx); empty for the game's own start, the intro and the title. SRB2 counts warping to a map not yet visited as a cheat: game data is then neither loaded nor saved."
    },
    {
      "name": "skin",
      "display": "Start Map Character",
      "type": "string",
      "default": "",
      "description": "The character Start Map plays as, by skin name: sonic, tails, knuckles, amy, fang, metalsonic, or an addon's (the game's +skin). Empty for the game's default, Sonic. Used only with a Start Map; without one, the game's character select chooses. A locked character (Amy, Fang, Metal Sonic) needs Unlock All Characters."
    }
  ],
  "firmware": [
    {
      "id": "srb2.pk3",
      "display": "SRB2 main data",
