{
  "coreName": "SRB2",
  "systemId": "SRB2",
  "systemNames": {
    "SRB2": "Sonic Robo Blast 2"
  },
  "kind": "game",
  "author": "Sonic Team Junior (Sonic Robo Blast 2, from Doom Legacy); unofficial Chimera port by P-AS",
  "url": "https://github.com/P-AS/chimera-core-srb2",
  "deterministic": true,
  "_memory_note": "[sbrk, sealed, invisible, plain, mmap] MiB: the engine's zone, its screens (five at the resolution, 41 MiB at 3840x2160) and the pk3s' cached lumps on the heap (and mmap past it), the engine's 16 MiB cothread stack in mmap; the picture's buffer (33 MiB at 3840x2160) and the sound's invisible (output, not the machine). As run-wbx has them.",
  "memoryLayoutMiB": [
    256,
    4,
    64,
    4,
    1024
  ],
  "video": {
    "_comment": "The software renderer at the resolution setting (up to 3840x2160), shown with square pixels as SRB2 is: the live size comes from GetVideoWidth/Height and the display aspect from GetDisplayAspectX/Y, which is that size itself.",
    "width": 3840,
    "height": 2160,
    "virtualWidth": 320,
    "virtualHeight": 200,
    "vsyncNumerator": 35,
    "vsyncDenominator": 1,
    "getBgra": "GetVideoBgra"
  },
  "audio": {
    "_comment": "The core's own mixer (platform/i_sound.c): a step is a tic, 1260 frames at 44100 Hz.",
    "rate": 44100,
    "samplesPerFrame": 1260,
    "channels": 2,
    "get": "GetAudio"
  },
  "lag": {
    "inputWasRead": "InputWasRead"
  },
  "input": {
    "name": "SRB2 Controller",
    "_comment": "SRB2's own keyboard in its default (FPS) scheme, pressed as keys - the menus read them too - and the menus' Enter and Escape (a prompt's yes and no too); and axes added into the tic command for exact values (Forward Move and Side Move count only while their keys are not held; Aim 0 leaves the game's own look). The ring-slinger controls are in but for the weapon slots (Weapon 1-7), left out to keep the UI uncrowded: Weapon Next and Prev reach every weapon. The order is srb2-input.c's. The mnemonics are each button's letter in a movie's text and TAStudio's column: the directions as Doom has them, arrows for moving and braces for turning.",
    "buttons": [
      "Forward",
      "Backward",
      "Strafe Left",
      "Strafe Right",
      "Turn Left",
      "Turn Right",
      "Look Up",
      "Look Down",
      "Jump",
      "Spin",
      "Fire",
      "Fire Normal",
      "Toss Flag",
      "Center View",
      "Reset Camera",
      "Camera Toggle",
      "Weapon Next",
      "Weapon Prev",
      "Custom 1",
      "Custom 2",
      "Custom 3",
      "Pause",
      "Enter",
      "Escape"
    ],
    "mnemonics": {
      "Forward": "^",
      "Backward": "v",
      "Strafe Left": "<",
      "Strafe Right": ">",
      "Turn Left": "{",
      "Turn Right": "}",
      "Look Up": "U",
      "Look Down": "D",
      "Jump": "J",
      "Spin": "S",
      "Fire": "F",
      "Fire Normal": "N",
      "Toss Flag": "G",
      "Center View": "C",
      "Reset Camera": "R",
      "Camera Toggle": "T",
      "Weapon Next": "+",
      "Weapon Prev": "-",
      "Custom 1": "1",
      "Custom 2": "2",
      "Custom 3": "3",
      "Pause": "P",
      "Enter": "E",
      "Escape": "e"
    },
    "axes": [
      {
        "name": "Forward Move",
        "min": -50,
        "max": 50,
        "neutral": 0,
        "header": "Fwd"
      },
      {
        "name": "Side Move",
        "min": -50,
        "max": 50,
        "neutral": 0,
        "header": "Side"
      },
      {
        "name": "Turn",
        "min": -32768,
        "max": 32767,
        "neutral": 0,
        "header": "Turn"
      },
      {
        "name": "Aim",
        "min": -32768,
        "max": 32767,
        "neutral": 0,
        "header": "Aim"
      }
    ]
  },
  "settings": [
    {
      "name": "playStyle",
      "display": "setting.playstyle",
      "type": "enum",
      "options": [
        "Strafe",
        "Manual",
        "Automatic",
        "Old Analog"
      ],
      "default": "Manual",
      "description": "setting.playstyle.about"
    },
    {
      "name": "cameraSpeed",
      "display": "setting.cameraspeed",
      "type": "float",
      "default": 1.0,
      "description": "setting.cameraspeed.about"
    },
    {
      "name": "cameraDistance",
      "display": "setting.cameradistance",
      "type": "float",
      "default": 192.0,
      "description": "setting.cameradistance.about"
    },
    {
